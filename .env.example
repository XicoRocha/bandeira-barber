# Ligação Postgres. No Supabase: Project Settings → Database → Connection string → "Transaction pooler" (porta 6543)
DATABASE_URL=postgres://postgres@127.0.0.1:5433/postgres
# Só para a base de dados local (npm run db:dev). No Supabase apagar esta linha.
DATABASE_POOL_MAX=1

# Segredo para as sessões da área de gestão (gera com: openssl rand -base64 32)
SESSION_SECRET=troca-isto-por-um-segredo-comprido

# Conta inicial do gestor (usada pelo npm run db:setup)
ADMIN_EMAIL=gestor@exemplo.pt
ADMIN_PASSWORD=muda-esta-password

# URL público da app (para os links nos emails/SMS)
APP_URL=http://localhost:3100

# Protege o endpoint de lembretes chamado pelo cron da Vercel
CRON_SECRET=outro-segredo

# Email (Resend — resend.com). Sem isto, os emails são só registados na consola.
RESEND_API_KEY=
EMAIL_FROM="Bandeira Barber <marcacoes@o-teu-dominio.pt>"

# SMS (Twilio — twilio.com). Sem isto, os SMS são só registados na consola.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=BandeiraBrb
